# Salin ke .env  (chmod 600). JANGAN di-commit dan JANGAN ditempel di chat/screenshot.
# Buat AUTH_SECRET dengan:  openssl rand -hex 32
AUTH_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
# Minimal 12 karakter, acak (jangan memakai nama brand/kata umum; server menolak yang lemah)
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
# Domain website (persis, dengan https://). Pisahkan koma bila lebih dari satu.
CORS_ORIGIN=https://contoh.com,https://www.contoh.com
# Port di host (hanya 127.0.0.1). Ganti bila bentrok dengan aplikasi lain.
API_HOST_PORT=8081
