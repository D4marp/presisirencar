# Salin ke /etc/presisi/api.env  (chmod 600, pemilik root). JANGAN di-commit nilai aslinya.
APP_ENV=production
LISTEN_ADDR=127.0.0.1:8080
TRUST_PROXY=1

# Buat dengan: openssl rand -hex 32
AUTH_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
# Minimal 10 karakter, makin panjang makin baik
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# Domain website frontend (persis, dengan https://). Pisahkan koma bila lebih dari satu.
CORS_ORIGIN=https://contoh.com,https://www.contoh.com

DATA_FILE=/var/lib/presisi/bookings.json
